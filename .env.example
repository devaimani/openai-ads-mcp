# API-Key aus dem Ads Manager: https://ads.openai.com -> Settings
# Ein Key gilt für genau ein Werbekonto.
OPENAI_ADS_API_KEY=sk-...

# Budgets darüber brauchen confirm_budget=True beim Anlegen.
OPENAI_ADS_BUDGET_CEILING=500

# Kontowährung. Steht in der Antwort von get_account, sobald das Kontoprofil
# vollständig ist.
OPENAI_ADS_CURRENCY=EUR

# 1 = keine schreibenden Tools registrieren.
OPENAI_ADS_MCP_READONLY=0

# Versuche je Anfrage, bevor endgültig abgebrochen wird. 409 und 429 werden
# wiederholt, 400/403/404 nicht.
OPENAI_ADS_MAX_RETRIES=4
